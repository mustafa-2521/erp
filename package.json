{
  "name": "mustafa-inks-erp",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/database"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:generate": "npm run generate -w packages/database",
    "db:push": "npm run push -w packages/database"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  }
}
